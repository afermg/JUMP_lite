  "@type": "sc:Dataset",
  "name": "JUMP-Lite",
  "description": "A compact, analysis-ready subset of the JUMP Cell Painting dataset with compressed five-channel microscopy images, per-site deep-learning embeddings, Cellpose instance masks, links to original TIFFs, perturbation metadata, and curated RefChemDB annotations.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "version": "1.0",
  "url": "https://github.com/afermg/JUMP_lite",
  "sameAs": [
    "https://doi.org/10.5281/zenodo.18705140",
    "https://registry.opendata.aws/cellpainting-gallery/"
  ],
  "license": "https://creativecommons.org/publicdomain/zero/1.0/",
  "citeAs": "Muñoz AF, Fredin Haslum J, Shen R, Carpenter AE, Singh S. (2026). JUMP-lite: Compact, reproducible benchmarking of cell representations. arXiv:2608.07632. https://doi.org/10.48550/arXiv.2608.07632",
  "creator": [
    {
      "@type": "sc:Person",
      "name": "Alejandro F. Muñoz"
    },
    {
      "@type": "sc:Person",
      "name": "Johannes Fredin Haslum"
    },
    {
      "@type": "sc:Person",
      "name": "Rui Shen"
    },
    {
      "@type": "sc:Person",
      "name": "Anne E. Carpenter"
    },
    {
      "@type": "sc:Person",
      "name": "Shantanu Singh"
    }
  ],
  "publisher": {
    "@type": "sc:Organization",
    "name": "Broad Institute of MIT and Harvard"
  },
  "keywords": [
    "Cell Painting",
    "microscopy",
    "morphological profiling",
    "image compression",
    "deep learning",
    "drug discovery",
    "CRISPR",
    "ORF",
    "JUMP Cell Painting Consortium"
  ],
