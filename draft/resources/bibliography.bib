  langid = {english},
  file = {/home/amunoz/Zotero/storage/3A66BEYA/Moshkov et al. - 2022 - Learning representations for image-based profiling of perturbations.pdf}
}

@article{moutakanniCellDINOSelfsupervisedImagebased2025,
  title = {Cell-{{DINO}}: {{Self-supervised}} Image-Based Embeddings for Cell Fluorescent Microscopy},
  shorttitle = {Cell-{{DINO}}},
  author = {Moutakanni, Th{\'e}o and Couprie, Camille and Yi, Seungeun and Doron, Michael and Chen, Zitong S. and Moshkov, Nikita and Gardes, Elouan and Caron, Mathilde and Touvron, Hugo and Joulin, Armand and Bojanowski, Piotr and Pernice, Wolfgang M. and Caicedo, Juan C.},
