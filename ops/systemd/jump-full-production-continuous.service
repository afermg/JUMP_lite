[Unit]
Description=Full-JUMP quarantined HQ/MQ continuous production compressor
ConditionPathExists=/work/datasets/jump_lite/full_jump_compression_state/v1.0/production.env
ConditionPathExists=/work/datasets/jump_lite/full_jump_compression_state/v1.0/full-jump-hq-mq-v1/continuous-authorization.json

[Service]
Type=exec
EnvironmentFile=/work/datasets/jump_lite/full_jump_compression_state/v1.0/production.env
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 BLIS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 TBB_NUM_THREADS=1 ARROW_NUM_THREADS=1 POLARS_MAX_THREADS=1 RAYON_NUM_THREADS=1
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=/run/current-system/sw/bin/env PYTHONPATH=${DEPLOY_ROOT}/src /work/users/amunoz/projects/JUMP_lite/.venv/bin/python -m jump_full_compression production-run --apply --continuous --production-id ${PRODUCTION_ID} --manifest ${MANIFEST} --audit-report ${AUDIT_REPORT} --build-report ${BUILD_REPORT} --exclusion-policy ${EXCLUSION_POLICY} --damaged-objects ${DAMAGED_OBJECTS} --damaged-sites ${DAMAGED_SITES} --qc-plates ${QC_PLATES} --output-root ${OUTPUT_ROOT} --state-root ${STATE_ROOT} --inventory-digest ${INVENTORY_DIGEST} --manifest-sha256 ${MANIFEST_SHA256} --manifest-size ${MANIFEST_SIZE} --audit-sha256 ${AUDIT_SHA256} --build-report-sha256 ${BUILD_REPORT_SHA256} --exclusion-policy-sha256 ${EXCLUSION_POLICY_SHA256} --damaged-objects-sha256 ${DAMAGED_OBJECTS_SHA256} --damaged-sites-sha256 ${DAMAGED_SITES_SHA256} --qc-plates-sha256 ${QC_PLATES_SHA256} --site-count ${SITE_COUNT}
Restart=no
TimeoutStopSec=30min
KillMode=control-group
CPUAffinity=64-80
Nice=19
CPUWeight=1
IOWeight=1
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/work/datasets/jump_lite/images/compressed/.jump_full_production/full-jump-hq-mq-v1 /work/datasets/jump_lite/full_jump_compression_state/v1.0/full-jump-hq-mq-v1
